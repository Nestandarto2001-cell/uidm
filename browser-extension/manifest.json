{
  "manifest_version": 3,
  "name": "МексоЁБ",
  "version": "1.0.0",
  "description": "Элитный торговый терминал для MEXC",
  "action": {
    "default_popup": "popup.html",
    "default_title": "МексоЁБ"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "alarms",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.mexc.com/*",
    "https://api.mexc.com/*",
    "https://contract.mexc.com/*",
    "https://futures.mexc.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.mexc.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cors",
        "enabled": true,
        "path": "rules/cors.json"
      }
    ]
  }
}