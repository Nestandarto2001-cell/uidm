{
  "manifest_version": 3,
  "name": "MEXC Terminal Bridge",
  "version": "0.1.0",
  "description": "Подключает терминал к MEXC для получения данных ордербука из оценочной зоны",
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://www.mexc.com/*",
    "https://futures.mexc.com/*",
    "https://contract.mexc.com/*",
    "https://mexcterminal.com/*",
    "https://*.mexc.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://mexcterminal.com/*"
      ],
      "js": ["terminal-bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "name": "mexc-content",
      "matches": [
        "https://www.mexc.com/*",
        "https://mexc.com/*",
        "https://futures.mexc.com/*",
        "https://contract.mexc.com/*"
      ],
      "js": ["content_mexc.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MEXC Terminal Connector"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": [
        "https://www.mexc.com/*",
        "https://mexc.com/*"
      ]
    }
  ]
}